From fa3265b288fad335915a273ae567fcec48477444 Mon Sep 17 00:00:00 2001
From: Amirali Ebrahimi <amirebrahimi97@gmail.com>
Date: Sun, 25 Oct 2026 11:24:18 -0400
Subject: [PATCH] hw/riscv: add the CVA5 PYNQ-Z2 machine

Models the SoC in the CVA5 repository's examples/xilinx/cva5_wrapper.sv and
the block design around it: an RV32IM machine-mode CPU, 128 KiB of RAM at
0x8000_0000 where programs run (entry 0x40 above its base), a CLINT, a PLIC
and an AXI UART Lite whose receive interrupt arrives on PLIC source 1.

The CLINT and PLIC are QEMU's own devices, which model the hardware without
adjustment because examples/sw/soc.h uses the standard SiFive register
layouts for both. Two details are not the defaults: the CLINT counts at
1 MHz, matching soc.h's CLINT_HZ, and the mtimer is created without rdtime
because the core sets INCLUDE_TIME_CSR to 0 and traps the instruction.

The SPI and the I2C are real on the board and are mapped unimplemented, as
is the Debug Module's window, since QEMU debugs through its own gdbstub.
Accesses to them are logged rather than reading as zero, which on a status
register would look like a device reporting itself idle.

Programs built for the board run unmodified: -kernel loads the application at
the reset vector, which on hardware is block RAM inside the core that the
bitstream preloads, so there is no ROM and nothing to jump through.

hw/intc: reserve PLIC source 0 in the enable bitmap

sifive_plic_write already refuses a priority write to source 0, on the
grounds that the source does not exist -- the PLIC specification reserves
interrupt ID 0 and implementations read it as zero. The enable path did
not apply the same rule: it stored the written word whole, so a guest
writing 0xffffffff to an enable register left bit 0 set, read it back
set, and sifive_plic_update would then consider a source that can never
be raised.

Masking bit 0 of the first enable word makes the device consistent with
its own treatment of priorities. It is also what hardware does: the CVA5
PLIC pins source 0's priority and enable bit to zero, which is checked
in that project's test_benches/axi/tb_plic.sv, and the divergence showed
up as the one failing check when its plic test was run against this
machine.
---
 hw/intc/sifive_plic.c |  10 ++
 hw/riscv/Kconfig      |   9 ++
 hw/riscv/cva5_pynq.c  | 301 ++++++++++++++++++++++++++++++++++++++++++
 hw/riscv/meson.build  |   1 +
 4 files changed, 321 insertions(+)
 create mode 100644 hw/riscv/cva5_pynq.c

diff --git a/hw/intc/sifive_plic.c b/hw/intc/sifive_plic.c
index 9c84ff0..d9ff071 100644
--- a/hw/intc/sifive_plic.c
+++ b/hw/intc/sifive_plic.c
@@ -218,6 +218,16 @@ static void sifive_plic_write(void *opaque, hwaddr addr, uint64_t value,
         uint32_t wordid = (addr & (plic->enable_stride - 1)) >> 2;
 
         if (wordid < plic->bitfield_words) {
+            if (wordid == 0) {
+                /*
+                 * Source 0 does not exist, so its enable bit is reserved and
+                 * reads as zero. The priority write above already refuses
+                 * source 0; without the same rule here the bitmap keeps
+                 * whatever a guest writes to bit 0, and sifive_plic_update can
+                 * then offer a claim for an interrupt that cannot be raised.
+                 */
+                value &= ~(uint64_t)1;
+            }
             plic->enable[addrid * plic->bitfield_words + wordid] = value;
         } else {
             qemu_log_mask(LOG_GUEST_ERROR,
diff --git a/hw/riscv/Kconfig b/hw/riscv/Kconfig
index de37c08..e31b002 100644
--- a/hw/riscv/Kconfig
+++ b/hw/riscv/Kconfig
@@ -9,6 +9,15 @@ config IBEX
 
 # RISC-V machines in alphabetical order
 
+config CVA5_PYNQ
+    bool
+    default y
+    depends on RISCV32
+    select XILINX
+    select UNIMP
+    select RISCV_ACLINT
+    select SIFIVE_PLIC
+
 config MICROCHIP_PFSOC
     bool
     default y
diff --git a/hw/riscv/cva5_pynq.c b/hw/riscv/cva5_pynq.c
new file mode 100644
index 0000000..c84653a
--- /dev/null
+++ b/hw/riscv/cva5_pynq.c
@@ -0,0 +1,301 @@
+/*
+ * QEMU model of the CVA5 PYNQ-Z2 system.
+ *
+ * Mirrors examples/xilinx/cva5_wrapper.sv from the CVA5 repository:
+ *
+ *   0x0000_0000    4 KiB  Debug Module window (not modelled)
+ *   0x0200_0000  768 KiB  CLINT -- mtime/mtimecmp and msip
+ *   0x0C00_0000   64 MiB  PLIC
+ *   0x1000_0000           AXI UART Lite, interrupt on PLIC source 1
+ *   0x2000_0000    8 MiB  SPI (not modelled)
+ *   0x2800_0000    4 KiB  I2C (not modelled)
+ *   0x8000_0000  128 KiB  main RAM; programs run here, entry at +0x40
+ *
+ * The addresses and the CLINT and PLIC register layouts come from
+ * examples/sw/soc.h, which states that both are the standard SiFive ones --
+ * so QEMU's own devices model them without adjustment. The two blocks that
+ * are not modelled are mapped unimplemented, so an access to them is logged
+ * rather than silently reading as zero.
+ *
+ * The CPU is RV32IM, machine mode only, matching the wrapper's CPU_CONFIG
+ * (misa reads 0x40001100 on hardware).
+ *
+ * Usage:
+ *   qemu-system-riscv32 -M cva5-pynq -nographic -kernel app.elf
+ *   qemu-system-riscv32 -M cva5-pynq -nographic -kernel app.elf -s -S   (gdb)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "target/riscv/cpu.h"
+#include "hw/core/boards.h"
+#include "hw/core/loader.h"
+#include "elf.h"
+#include "hw/core/sysbus.h"
+#include "hw/char/xilinx_uartlite.h"
+#include "hw/intc/riscv_aclint.h"
+#include "hw/intc/sifive_plic.h"
+#include "hw/misc/unimp.h"
+#include "system/address-spaces.h"
+#include "system/system.h"
+/*
+ * qemu_register_reset moved from sysemu/ to system/ during the tree
+ * reorganisation; accept either so this machine builds against both.
+ */
+#if defined(__has_include)
+#  if __has_include("system/reset.h")
+#    include "system/reset.h"
+#  elif __has_include("sysemu/reset.h")
+#    include "sysemu/reset.h"
+#  endif
+#else
+#  include "system/reset.h"
+#endif
+
+/*
+ * Machines in some QEMU versions must declare which of qemu-system-riscv32 and
+ * qemu-system-riscv64 they belong to; without that they register but are
+ * filtered out of the machine list. Later versions dropped the requirement.
+ */
+#if defined(__has_include)
+#  if __has_include("hw/riscv/machines-qom.h")
+#    include "hw/riscv/machines-qom.h"
+#    define CVA5_DEFINE_MACHINE DEFINE_MACHINE_RISCV32
+#  endif
+#endif
+#ifndef CVA5_DEFINE_MACHINE
+#  define CVA5_DEFINE_MACHINE DEFINE_MACHINE
+#endif
+
+#define CVA5_RAM_BASE   0x80000000
+#define CVA5_RAM_SIZE   (128 * KiB)
+#define CVA5_DM_BASE    0x00000000
+#define CVA5_DM_SIZE    (4 * KiB)
+#define CVA5_UART_BASE  0x10000000
+#define CVA5_APP_ENTRY  (CVA5_RAM_BASE + 0x40)
+#define CVA5_ROM_BASE   0x00010000
+#define CVA5_ROM_SIZE   (4 * KiB)
+#define CVA5_TRAP_VEC   CVA5_RAM_BASE
+
+#define CVA5_CLINT_BASE 0x02000000
+#define CVA5_PLIC_BASE  0x0c000000
+#define CVA5_PLIC_SIZE  (64 * MiB)
+#define CVA5_SPI_BASE   0x20000000
+#define CVA5_SPI_SIZE   (8 * MiB)
+#define CVA5_I2C_BASE   0x28000000
+#define CVA5_I2C_SIZE   (4 * KiB)
+
+/*
+ * The CLINT counts at 1 MHz, not at the CPU clock: cva5_clint_axi divides the
+ * 100 MHz system clock down so that mtime ticks once per microsecond, which is
+ * what examples/sw/soc.h's CLINT_HZ says and what examples/sw/timer.c's
+ * microsecond arithmetic assumes. QEMU's default is 10 MHz, so passing this
+ * matters -- a timer test would otherwise be out by ten.
+ */
+#define CVA5_CLINT_HZ   1000000
+
+/*
+ * PLIC geometry. The standard SiFive layout, which is what cva5_plic_axi
+ * implements and what soc.h documents: priorities from the base, pending at
+ * 0x1000, enables at 0x2000, and one context per hart at 0x200000.
+ *
+ * Three sources rather than two, because source 0 does not exist in a PLIC and
+ * the count includes it: soc.h's PLIC_NUM_SOURCES of 2 means sources 1 and 2.
+ */
+#define CVA5_PLIC_NUM_SOURCES   3
+#define CVA5_PLIC_NUM_PRIO_BITS 3
+#define CVA5_PLIC_PRIORITY_BASE 0x00
+#define CVA5_PLIC_PENDING_BASE  0x1000
+#define CVA5_PLIC_ENABLE_BASE   0x2000
+#define CVA5_PLIC_ENABLE_STRIDE 0x80
+#define CVA5_PLIC_CONTEXT_BASE  0x200000
+#define CVA5_PLIC_CONTEXT_STRIDE 0x1000
+
+/* The source numbers examples/sw/soc.h declares, and cva5_irq_concat wires. */
+#define CVA5_PLIC_SRC_UART      1
+#define CVA5_PLIC_SRC_SPI       2
+
+/*
+ * The boot ROM, built the way examples/xilinx/vendor/boot_rom.sv builds
+ * it: lui x1, %hi(entry) then jalr x0, %lo(entry)(x1). The 0x800 is the
+ * carry correction every assembler applies for %hi, because jalr
+ * sign-extends its 12-bit immediate.
+ */
+#define CVA5_ROM_HI     ((uint32_t)(((CVA5_APP_ENTRY) + 0x800u) >> 12))
+#define CVA5_ROM_LO     ((uint32_t)((CVA5_APP_ENTRY) & 0xfffu))
+
+/*
+ * On the board RESET_TVEC is a hardware parameter -- the reset value of
+ * mtvec -- and nothing in examples/sw writes mtvec, so it is the trap
+ * vector for the life of the program. QEMU has no property for it and the
+ * CPU's own reset clears mtvec, so it is restored afterwards: reset
+ * handlers run in registration order and qemu_devices_reset() is
+ * registered during machine setup, before this one.
+ */
+static void cva5_post_reset(void *opaque)
+{
+    RISCVCPU *cpu = opaque;
+
+    cpu->env.mtvec = CVA5_TRAP_VEC;
+}
+
+static void cva5_pynq_init(MachineState *machine)
+{
+    MemoryRegion *sysmem = get_system_memory();
+    MemoryRegion *ram = g_new(MemoryRegion, 1);
+    RISCVCPU *cpu;
+    DeviceState *uart;
+    DeviceState *plic;
+    uint64_t entry;
+
+    /* RV32IM, machine mode only: no A, C, F, D, and no S or U privilege */
+    cpu = RISCV_CPU(object_new(machine->cpu_type));
+    /*
+     * The rv32 base CPU turns on a number of newer extensions by default;
+     * switch off everything CVA5 does not implement so that misa and the
+     * instruction set match the hardware (misa = 0x40001100, RV32IM).
+     */
+    static const char *const off[] = {
+        "a", "c", "f", "d", "h", "s", "u",
+        "zawrs", "zfa", "zfh", "zfhmin", "zba", "zbb", "zbc", "zbs",
+        "zicbom", "zicbop", "zicboz", "zicond", "zihintpause", "zihintntl",
+        "zksed", "zksh", "zkt", "sstc", "svadu", "svinval", "svnapot", "svpbmt",
+    };
+    for (int i = 0; i < ARRAY_SIZE(off); i++) {
+        object_property_set_bool(OBJECT(cpu), off[i], false, NULL);
+    }
+    object_property_set_int(OBJECT(cpu), "resetvec", CVA5_ROM_BASE,
+                            &error_abort);
+    qdev_realize(DEVICE(cpu), NULL, &error_abort);
+    qemu_register_reset(cva5_post_reset, cpu);
+
+    /* Main RAM: the debugger loads programs here on hardware */
+    memory_region_init_ram(ram, NULL, "cva5.ram", CVA5_RAM_SIZE, &error_fatal);
+    memory_region_add_subregion(sysmem, CVA5_RAM_BASE, ram);
+
+    /*
+     * CLINT. Split into the ACLINT MSWI and MTIMER devices, which between them
+     * occupy the same register layout the single SiFive CLINT had: msip at the
+     * base, mtimecmp at 0x4000 and mtime at 0xbff8, exactly the offsets
+     * examples/sw/soc.h uses.
+     *
+     * provide_rdtime is false, which is the point of saying so here. The
+     * hardware sets INCLUDE_TIME_CSR to 0 -- the CLINT publishes mtime on the
+     * bus and the core has no time CSR -- so rdtime traps as an illegal
+     * instruction on the board. Letting QEMU provide it would make this model
+     * more capable than the thing it models, which is the one divergence
+     * examples/sw/csrs.c exists to catch.
+     */
+    riscv_aclint_swi_create(CVA5_CLINT_BASE, 0, 1, false);
+    riscv_aclint_mtimer_create(CVA5_CLINT_BASE + RISCV_ACLINT_SWI_SIZE,
+                               RISCV_ACLINT_DEFAULT_MTIMER_SIZE, 0, 1,
+                               RISCV_ACLINT_DEFAULT_MTIMECMP,
+                               RISCV_ACLINT_DEFAULT_MTIME,
+                               CVA5_CLINT_HZ, false);
+
+    /*
+     * PLIC. One hart, machine mode only -- the core is configured MODES : M,
+     * so there is no supervisor context, and the single context at 0x200000 is
+     * the one soc.h's threshold and claim offsets address.
+     */
+    {
+        char hart_config[] = "M";
+
+        plic = sifive_plic_create(CVA5_PLIC_BASE, hart_config, 1, 0,
+                                  CVA5_PLIC_NUM_SOURCES,
+                                  (1U << CVA5_PLIC_NUM_PRIO_BITS) - 1,
+                                  CVA5_PLIC_PRIORITY_BASE,
+                                  CVA5_PLIC_PENDING_BASE,
+                                  CVA5_PLIC_ENABLE_BASE,
+                                  CVA5_PLIC_ENABLE_STRIDE,
+                                  CVA5_PLIC_CONTEXT_BASE,
+                                  CVA5_PLIC_CONTEXT_STRIDE,
+                                  CVA5_PLIC_SIZE);
+    }
+
+    /*
+     * AXI UART Lite, with its receive interrupt on PLIC source 1 -- the
+     * number soc.h declares and cva5_irq_concat wires on the board.
+     */
+    uart = qdev_new(TYPE_XILINX_UARTLITE);
+    qdev_prop_set_enum(uart, "endianness", ENDIAN_MODE_LITTLE);
+    qdev_prop_set_chr(uart, "chardev", serial_hd(0));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(uart), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(uart), 0, CVA5_UART_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(uart), 0,
+                       qdev_get_gpio_in(plic, CVA5_PLIC_SRC_UART));
+
+    /*
+     * PLIC source 2 is the SPI's transfer-complete interrupt on the board.
+     * There is no SPI model here to raise it, so the source exists and stays
+     * low: software that enables it waits forever rather than reading a
+     * fabricated interrupt.
+     */
+
+    /*
+     * The Debug Module's window. QEMU debugs through its own gdbstub, so the
+     * module itself is not modelled; mapping it keeps stray accesses visible
+     * instead of aborting.
+     */
+    create_unimplemented_device("cva5.dm", CVA5_DM_BASE, CVA5_DM_SIZE);
+
+    /*
+     * The SPI and the I2C. Both are real on the board and neither is modelled:
+     * they are register-level models of specific third-party cores, and
+     * without something attached to the pins there is nothing for them to
+     * talk to. Mapped unimplemented so that a program touching them says so
+     * in the QEMU log instead of reading zeros that look like a device
+     * reporting idle.
+     */
+    create_unimplemented_device("cva5.spi", CVA5_SPI_BASE, CVA5_SPI_SIZE);
+    create_unimplemented_device("cva5.i2c", CVA5_I2C_BASE, CVA5_I2C_SIZE);
+
+    /* Boot ROM: the reset vector, and the two instructions it holds */
+    {
+        MemoryRegion *rom = g_new(MemoryRegion, 1);
+        static const uint32_t boot[2] = {
+            (CVA5_ROM_HI << 12) | (1u << 7) | 0x37u,    /* lui  x1, %hi    */
+            (CVA5_ROM_LO << 20) | (1u << 15) | 0x67u,   /* jalr x0, %lo(x1) */
+        };
+
+        memory_region_init_rom(rom, NULL, "cva5.rom", CVA5_ROM_SIZE,
+                               &error_fatal);
+        memory_region_add_subregion(sysmem, CVA5_ROM_BASE, rom);
+        rom_add_blob_fixed_as("cva5.rom", boot, sizeof(boot), CVA5_ROM_BASE,
+                              &address_space_memory);
+    }
+
+    /*
+     * The application. The reset vector is the boot ROM above, which jumps
+     * here, so a kernel whose entry point is not CVA5_APP_ENTRY would be
+     * loaded and then never reached -- hence the check.
+     */
+    if (machine->kernel_filename) {
+        if (load_elf(machine->kernel_filename, NULL, NULL, NULL, &entry, NULL,
+                     NULL, NULL, 0, EM_RISCV, 1, 0) <= 0) {
+            error_report("could not load kernel '%s'",
+                         machine->kernel_filename);
+            exit(1);
+        }
+        if (entry != CVA5_APP_ENTRY) {
+            warn_report("kernel entry is 0x%" PRIx64 ", but the reset vector "
+                        "is 0x%x", entry, CVA5_APP_ENTRY);
+        }
+    }
+}
+
+static void cva5_pynq_machine_init(MachineClass *mc)
+{
+    mc->desc = "CVA5 on the PYNQ-Z2 (RV32IM, machine mode)";
+    mc->init = cva5_pynq_init;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->default_cpus = 1;
+    mc->default_cpu_type = TYPE_RISCV_CPU_BASE32;
+}
+
+CVA5_DEFINE_MACHINE("cva5-pynq", cva5_pynq_machine_init)
diff --git a/hw/riscv/meson.build b/hw/riscv/meson.build
index 0d82cea..874b9ed 100644
--- a/hw/riscv/meson.build
+++ b/hw/riscv/meson.build
@@ -15,6 +15,7 @@ riscv_ss.add(when: 'CONFIG_TENSTORRENT', if_true: files('tt_atlantis.c'))
 riscv_ss.add(when: 'CONFIG_ACPI', if_true: files('virt-acpi-build.c'))
 riscv_ss.add(when: 'CONFIG_RISCV_IOMMU', if_true: files(
 	'riscv-iommu.c', 'riscv-iommu-pci.c', 'riscv-iommu-sys.c', 'riscv-iommu-hpm.c'))
+riscv_ss.add(when: 'CONFIG_CVA5_PYNQ', if_true: files('cva5_pynq.c'))
 riscv_ss.add(when: 'CONFIG_MICROBLAZE_V', if_true: files('microblaze-v-generic.c'))
 riscv_ss.add(when: 'CONFIG_XIANGSHAN_KUNMINGHU', if_true: files('xiangshan_kmh.c'))
 riscv_ss.add(when: 'CONFIG_RISCV_MIPS_CPS', if_true: files('cps.c'))
-- 
