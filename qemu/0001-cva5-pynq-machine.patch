From 89914cdd9b0224e48f1c5b3568f562031125f3b0 Mon Sep 17 00:00:00 2001
From: Amirali Ebrahimi <amirebrahimi97@gmail.com>
Date: Sun, 25 Oct 2026 11:38:00 -0400
Subject: [PATCH] hw/riscv: add the CVA5 PYNQ-Z2 machine

Models the SoC in the CVA5 repository's examples/xilinx/cva5_wrapper.sv and
the block design around it: an RV32IM machine-mode CPU, 128 KiB of RAM at
0x8000_0000 where programs run (entry 0x40 above its base), a CLINT, a PLIC
and an AXI UART Lite whose receive interrupt arrives on PLIC source 1.

The CLINT and PLIC are QEMU's own devices, which model the hardware without
adjustment because examples/sw/soc.h uses the standard SiFive register
layouts for both. Two details are not the defaults: the CLINT counts at
1 MHz, matching soc.h's CLINT_HZ, and the mtimer is created without rdtime
because the core sets INCLUDE_TIME_CSR to 0 and traps the instruction.

The SPI and the I2C are real on the board and are mapped unimplemented, as
is the Debug Module's window, since QEMU debugs through its own gdbstub.
Accesses to them are logged rather than reading as zero, which on a status
register would look like a device reporting itself idle.

Programs built for the board run unmodified: -kernel loads the application at
the reset vector, which on hardware is block RAM inside the core that the
bitstream preloads, so there is no ROM and nothing to jump through.

hw/intc: reserve PLIC source 0 in the enable bitmap

sifive_plic_write already refuses a priority write to source 0, on the
grounds that the source does not exist -- the PLIC specification reserves
interrupt ID 0 and implementations read it as zero. The enable path did
not apply the same rule: it stored the written word whole, so a guest
writing 0xffffffff to an enable register left bit 0 set, read it back
set, and sifive_plic_update would then consider a source that can never
be raised.

Masking bit 0 of the first enable word makes the device consistent with
its own treatment of priorities, and matches hardware: the CVA5 PLIC pins
source 0's priority and enable bit to zero.

hw/char: make the uartlite interrupt follow the receive FIFO

The interrupt was latched and could not be cleared. STATUS_IE served as
a pending flag: uart_update_irq ORed it in whenever the receive FIFO was
non-empty, uart_update_status never cleared it -- it masks only bits 0
to 2 -- and the transmit path set it on every character written, under a
comment reading "hax".

So the interrupt asserted on the first byte received or the first
character printed, and then stayed asserted for the life of the machine.
A guest that enabled it saw an interrupt it had no way to quiet, and
could not distinguish "a byte is waiting" from "a byte arrived at some
point". Printing from the handler was enough to re-raise it.

In the device being modelled, STATUS bit 4 reports whether the interrupt
is enabled -- it mirrors the control register's bit -- and the interrupt
itself follows the receive FIFO. This makes the model do both: the irq is
now rx_fifo_len && (CTRL & IE), draining the FIFO lowers it, and
uart_update_status presents bit 4 as the mirror it is.

Found by running a PLIC test against the CVA5 machine. The test drains
the FIFO before enabling interrupts, printed its own progress, and was
then interrupted by its own output.
---
 hw/char/xilinx_uartlite.c |  25 +++-
 hw/intc/sifive_plic.c     |  10 ++
 hw/riscv/Kconfig          |   9 ++
 hw/riscv/cva5_pynq.c      | 301 ++++++++++++++++++++++++++++++++++++++
 hw/riscv/meson.build      |   1 +
 5 files changed, 339 insertions(+), 7 deletions(-)
 create mode 100644 hw/riscv/cva5_pynq.c

diff --git a/hw/char/xilinx_uartlite.c b/hw/char/xilinx_uartlite.c
index 3ef99ad..c55b0c0 100644
--- a/hw/char/xilinx_uartlite.c
+++ b/hw/char/xilinx_uartlite.c
@@ -74,10 +74,21 @@ static void uart_update_irq(XilinxUARTLite *s)
 {
     unsigned int irq;
 
-    if (s->rx_fifo_len)
-        s->regs[R_STATUS] |= STATUS_IE;
-
-    irq = (s->regs[R_STATUS] & STATUS_IE) && (s->regs[R_CTRL] & CONTROL_IE);
+    /*
+     * The interrupt follows the receive FIFO, gated by the control register's
+     * enable bit. It is not latched: draining the FIFO lowers it again.
+     *
+     * STATUS_IE used to serve as a pending flag here -- it was ORed in
+     * whenever the FIFO was non-empty and never cleared, and the transmit
+     * path set it on every character written, with a comment saying "hax".
+     * Between them the interrupt asserted after the first byte or the first
+     * character of output and then stayed asserted for the life of the
+     * machine, so a guest could neither tell why it had been interrupted nor
+     * make the interrupt stop. In the device being modelled STATUS bit 4 is
+     * "interrupt enabled", a mirror of the control bit, not a pending flag;
+     * uart_update_status now presents it that way.
+     */
+    irq = !!s->rx_fifo_len && (s->regs[R_CTRL] & CONTROL_IE);
     qemu_set_irq(s->irq, irq);
 }
 
@@ -90,6 +101,9 @@ static void uart_update_status(XilinxUARTLite *s)
     r |= 1 << 2; /* Tx fifo is always empty. We are fast :) */
     r |= (s->rx_fifo_len == sizeof (s->rx_fifo)) << 1;
     r |= (!!s->rx_fifo_len);
+    /* Bit 4 reports whether the interrupt is enabled, and nothing else. */
+    r &= ~STATUS_IE;
+    r |= (s->regs[R_CTRL] & CONTROL_IE) ? STATUS_IE : 0;
     s->regs[R_STATUS] = r;
 }
 
@@ -153,9 +167,6 @@ uart_write(void *opaque, hwaddr addr,
              * qemu_chr_fe_write and background I/O callbacks */
             qemu_chr_fe_write_all(&s->chr, &ch, 1);
             s->regs[addr] = value;
-
-            /* hax.  */
-            s->regs[R_STATUS] |= STATUS_IE;
             break;
 
         default:
diff --git a/hw/intc/sifive_plic.c b/hw/intc/sifive_plic.c
index 9c84ff0..d9ff071 100644
--- a/hw/intc/sifive_plic.c
+++ b/hw/intc/sifive_plic.c
@@ -218,6 +218,16 @@ static void sifive_plic_write(void *opaque, hwaddr addr, uint64_t value,
         uint32_t wordid = (addr & (plic->enable_stride - 1)) >> 2;
 
         if (wordid < plic->bitfield_words) {
+            if (wordid == 0) {
+                /*
+                 * Source 0 does not exist, so its enable bit is reserved and
+                 * reads as zero. The priority write above already refuses
+                 * source 0; without the same rule here the bitmap keeps
+                 * whatever a guest writes to bit 0, and sifive_plic_update can
+                 * then offer a claim for an interrupt that cannot be raised.
+                 */
+                value &= ~(uint64_t)1;
+            }
             plic->enable[addrid * plic->bitfield_words + wordid] = value;
         } else {
             qemu_log_mask(LOG_GUEST_ERROR,
diff --git a/hw/riscv/Kconfig b/hw/riscv/Kconfig
index de37c08..e31b002 100644
--- a/hw/riscv/Kconfig
+++ b/hw/riscv/Kconfig
@@ -9,6 +9,15 @@ config IBEX
 
 # RISC-V machines in alphabetical order
 
+config CVA5_PYNQ
+    bool
+    default y
+    depends on RISCV32
+    select XILINX
+    select UNIMP
+    select RISCV_ACLINT
+    select SIFIVE_PLIC
+
 config MICROCHIP_PFSOC
     bool
     default y
diff --git a/hw/riscv/cva5_pynq.c b/hw/riscv/cva5_pynq.c
new file mode 100644
index 0000000..c84653a
--- /dev/null
+++ b/hw/riscv/cva5_pynq.c
@@ -0,0 +1,333 @@
+/*
+ * QEMU model of the CVA5 PYNQ-Z2 system.
+ *
+ * Mirrors examples/xilinx/cva5_wrapper.sv from the CVA5 repository:
+ *
+ *   0x0000_0000    4 KiB  Debug Module window (not modelled)
+ *   0x0200_0000  768 KiB  CLINT -- mtime/mtimecmp and msip
+ *   0x0C00_0000   64 MiB  PLIC
+ *   0x1000_0000           AXI UART Lite, interrupt on PLIC source 1
+ *   0x2000_0000    8 MiB  SPI (not modelled)
+ *   0x2800_0000    4 KiB  I2C (not modelled)
+ *   0x8000_0000  128 KiB  main RAM; programs run here, entry at +0x40
+ *
+ * The addresses and the CLINT and PLIC register layouts come from
+ * examples/sw/soc.h, which states that both are the standard SiFive ones --
+ * so QEMU's own devices model them without adjustment. The two blocks that
+ * are not modelled are mapped unimplemented, so an access to them is logged
+ * rather than silently reading as zero.
+ *
+ * The CPU is RV32IM, machine mode only, matching the wrapper's CPU_CONFIG
+ * (misa reads 0x40001100 on hardware).
+ *
+ * Usage:
+ *   qemu-system-riscv32 -M cva5-pynq -nographic -kernel app.elf
+ *   qemu-system-riscv32 -M cva5-pynq -nographic -kernel app.elf -s -S   (gdb)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "target/riscv/cpu.h"
+#include "hw/core/boards.h"
+#include "hw/core/loader.h"
+#include "elf.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/char/xilinx_uartlite.h"
+#include "hw/intc/riscv_aclint.h"
+#include "hw/intc/sifive_plic.h"
+#include "hw/misc/unimp.h"
+#include "system/address-spaces.h"
+#include "system/system.h"
+/*
+ * qemu_register_reset moved from sysemu/ to system/ during the tree
+ * reorganisation; accept either so this machine builds against both.
+ */
+#if defined(__has_include)
+#  if __has_include("system/reset.h")
+#    include "system/reset.h"
+#  elif __has_include("sysemu/reset.h")
+#    include "sysemu/reset.h"
+#  endif
+#else
+#  include "system/reset.h"
+#endif
+
+/*
+ * Machines in some QEMU versions must declare which of qemu-system-riscv32 and
+ * qemu-system-riscv64 they belong to; without that they register but are
+ * filtered out of the machine list. Later versions dropped the requirement.
+ */
+#if defined(__has_include)
+#  if __has_include("hw/riscv/machines-qom.h")
+#    include "hw/riscv/machines-qom.h"
+#    define CVA5_DEFINE_MACHINE DEFINE_MACHINE_RISCV32
+#  endif
+#endif
+#ifndef CVA5_DEFINE_MACHINE
+#  define CVA5_DEFINE_MACHINE DEFINE_MACHINE
+#endif
+
+#define CVA5_RAM_BASE   0x80000000
+#define CVA5_RAM_SIZE   (128 * KiB)
+#define CVA5_DM_BASE    0x00000000
+#define CVA5_DM_SIZE    (4 * KiB)
+#define CVA5_UART_BASE  0x10000000
+#define CVA5_APP_ENTRY  (CVA5_RAM_BASE + 0x40)
+#define CVA5_ROM_BASE   0x00010000
+#define CVA5_ROM_SIZE   (4 * KiB)
+#define CVA5_TRAP_VEC   CVA5_RAM_BASE
+
+#define CVA5_CLINT_BASE 0x02000000
+#define CVA5_PLIC_BASE  0x0c000000
+#define CVA5_PLIC_SIZE  (64 * MiB)
+#define CVA5_SPI_BASE   0x20000000
+#define CVA5_SPI_SIZE   (8 * MiB)
+#define CVA5_I2C_BASE   0x28000000
+#define CVA5_I2C_SIZE   (4 * KiB)
+#define CVA5_ACCEL_BASE 0x50000000
+
+/*
+ * The CLINT counts at 1 MHz, not at the CPU clock: cva5_clint_axi divides the
+ * 100 MHz system clock down so that mtime ticks once per microsecond, which is
+ * what examples/sw/soc.h's CLINT_HZ says and what examples/sw/timer.c's
+ * microsecond arithmetic assumes. QEMU's default is 10 MHz, so passing this
+ * matters -- a timer test would otherwise be out by ten.
+ */
+#define CVA5_CLINT_HZ   1000000
+
+/*
+ * PLIC geometry. The standard SiFive layout, which is what cva5_plic_axi
+ * implements and what soc.h documents: priorities from the base, pending at
+ * 0x1000, enables at 0x2000, and one context per hart at 0x200000.
+ *
+ * Four rather than three, because source 0 does not exist in a PLIC and the
+ * count includes it: soc.h's PLIC_NUM_SOURCES of 3 means sources 1, 2 and 3 --
+ * the UART, the SPI and the accelerator's result-ready.
+ */
+#define CVA5_PLIC_NUM_SOURCES   4
+#define CVA5_PLIC_NUM_PRIO_BITS 3
+#define CVA5_PLIC_PRIORITY_BASE 0x00
+#define CVA5_PLIC_PENDING_BASE  0x1000
+#define CVA5_PLIC_ENABLE_BASE   0x2000
+#define CVA5_PLIC_ENABLE_STRIDE 0x80
+#define CVA5_PLIC_CONTEXT_BASE  0x200000
+#define CVA5_PLIC_CONTEXT_STRIDE 0x1000
+
+/* The source numbers examples/sw/soc.h declares, and cva5_irq_concat wires. */
+#define CVA5_PLIC_SRC_UART      1
+#define CVA5_PLIC_SRC_SPI       2
+
+/*
+ * The boot ROM, built the way examples/xilinx/vendor/boot_rom.sv builds
+ * it: lui x1, %hi(entry) then jalr x0, %lo(entry)(x1). The 0x800 is the
+ * carry correction every assembler applies for %hi, because jalr
+ * sign-extends its 12-bit immediate.
+ */
+#define CVA5_ROM_HI     ((uint32_t)(((CVA5_APP_ENTRY) + 0x800u) >> 12))
+#define CVA5_ROM_LO     ((uint32_t)((CVA5_APP_ENTRY) & 0xfffu))
+
+/*
+ * On the board RESET_TVEC is a hardware parameter -- the reset value of
+ * mtvec -- and nothing in examples/sw writes mtvec, so it is the trap
+ * vector for the life of the program. QEMU has no property for it and the
+ * CPU's own reset clears mtvec, so it is restored afterwards: reset
+ * handlers run in registration order and qemu_devices_reset() is
+ * registered during machine setup, before this one.
+ */
+static void cva5_post_reset(void *opaque)
+{
+    RISCVCPU *cpu = opaque;
+
+    cpu->env.mtvec = CVA5_TRAP_VEC;
+}
+
+static void cva5_pynq_init(MachineState *machine)
+{
+    MemoryRegion *sysmem = get_system_memory();
+    MemoryRegion *ram = g_new(MemoryRegion, 1);
+    RISCVCPU *cpu;
+    DeviceState *uart;
+    DeviceState *plic;
+    uint64_t entry;
+
+    /* RV32IM, machine mode only: no A, C, F, D, and no S or U privilege */
+    cpu = RISCV_CPU(object_new(machine->cpu_type));
+    /*
+     * The rv32 base CPU turns on a number of newer extensions by default;
+     * switch off everything CVA5 does not implement so that misa and the
+     * instruction set match the hardware (misa = 0x40001100, RV32IM).
+     */
+    static const char *const off[] = {
+        "a", "c", "f", "d", "h", "s", "u",
+        "zawrs", "zfa", "zfh", "zfhmin", "zba", "zbb", "zbc", "zbs",
+        "zicbom", "zicbop", "zicboz", "zicond", "zihintpause", "zihintntl",
+        "zksed", "zksh", "zkt", "sstc", "svadu", "svinval", "svnapot", "svpbmt",
+    };
+    for (int i = 0; i < ARRAY_SIZE(off); i++) {
+        object_property_set_bool(OBJECT(cpu), off[i], false, NULL);
+    }
+    object_property_set_int(OBJECT(cpu), "resetvec", CVA5_ROM_BASE,
+                            &error_abort);
+    qdev_realize(DEVICE(cpu), NULL, &error_abort);
+    qemu_register_reset(cva5_post_reset, cpu);
+
+    /* Main RAM: the debugger loads programs here on hardware */
+    memory_region_init_ram(ram, NULL, "cva5.ram", CVA5_RAM_SIZE, &error_fatal);
+    memory_region_add_subregion(sysmem, CVA5_RAM_BASE, ram);
+
+    /*
+     * CLINT. Split into the ACLINT MSWI and MTIMER devices, which between them
+     * occupy the same register layout the single SiFive CLINT had: msip at the
+     * base, mtimecmp at 0x4000 and mtime at 0xbff8, exactly the offsets
+     * examples/sw/soc.h uses.
+     *
+     * provide_rdtime is false, which is the point of saying so here. The
+     * hardware sets INCLUDE_TIME_CSR to 0 -- the CLINT publishes mtime on the
+     * bus and the core has no time CSR -- so rdtime traps as an illegal
+     * instruction on the board. Letting QEMU provide it would make this model
+     * more capable than the thing it models, which is the one divergence
+     * examples/sw/csrs.c exists to catch.
+     */
+    riscv_aclint_swi_create(CVA5_CLINT_BASE, 0, 1, false);
+    riscv_aclint_mtimer_create(CVA5_CLINT_BASE + RISCV_ACLINT_SWI_SIZE,
+                               RISCV_ACLINT_DEFAULT_MTIMER_SIZE, 0, 1,
+                               RISCV_ACLINT_DEFAULT_MTIMECMP,
+                               RISCV_ACLINT_DEFAULT_MTIME,
+                               CVA5_CLINT_HZ, false);
+
+    /*
+     * PLIC. One hart, machine mode only -- the core is configured MODES : M,
+     * so there is no supervisor context, and the single context at 0x200000 is
+     * the one soc.h's threshold and claim offsets address.
+     */
+    {
+        char hart_config[] = "M";
+
+        plic = sifive_plic_create(CVA5_PLIC_BASE, hart_config, 1, 0,
+                                  CVA5_PLIC_NUM_SOURCES,
+                                  (1U << CVA5_PLIC_NUM_PRIO_BITS) - 1,
+                                  CVA5_PLIC_PRIORITY_BASE,
+                                  CVA5_PLIC_PENDING_BASE,
+                                  CVA5_PLIC_ENABLE_BASE,
+                                  CVA5_PLIC_ENABLE_STRIDE,
+                                  CVA5_PLIC_CONTEXT_BASE,
+                                  CVA5_PLIC_CONTEXT_STRIDE,
+                                  CVA5_PLIC_SIZE);
+    }
+
+    /*
+     * AXI UART Lite, with its receive interrupt on PLIC source 1 -- the
+     * number soc.h declares and cva5_irq_concat wires on the board.
+     */
+    uart = qdev_new(TYPE_XILINX_UARTLITE);
+    qdev_prop_set_enum(uart, "endianness", ENDIAN_MODE_LITTLE);
+    qdev_prop_set_chr(uart, "chardev", serial_hd(0));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(uart), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(uart), 0, CVA5_UART_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(uart), 0,
+                       qdev_get_gpio_in(plic, CVA5_PLIC_SRC_UART));
+
+    /*
+     * PLIC source 2 is the SPI's transfer-complete interrupt on the board.
+     * There is no SPI model here to raise it, so the source exists and stays
+     * low: software that enables it waits forever rather than reading a
+     * fabricated interrupt.
+     */
+
+    /*
+     * The Debug Module's window. QEMU debugs through its own gdbstub, so the
+     * module itself is not modelled; mapping it keeps stray accesses visible
+     * instead of aborting.
+     */
+    create_unimplemented_device("cva5.dm", CVA5_DM_BASE, CVA5_DM_SIZE);
+
+    /*
+     * The SPI and the I2C. Both are real on the board and neither is modelled:
+     * they are register-level models of specific third-party cores, and
+     * without something attached to the pins there is nothing for them to
+     * talk to. Mapped unimplemented so that a program touching them says so
+     * in the QEMU log instead of reading zeros that look like a device
+     * reporting idle.
+     */
+    create_unimplemented_device("cva5.spi", CVA5_SPI_BASE, CVA5_SPI_SIZE);
+    create_unimplemented_device("cva5.i2c", CVA5_I2C_BASE, CVA5_I2C_SIZE);
+
+    /*
+     * The accelerator.
+     *
+     * The network is not modelled here. The device dlopens hls4ml's own
+     * generated C++, built by tools/nn_accel/host_model.py --so and checked
+     * bit for bit against the board, so retraining the model regenerates
+     * the simulator and nothing here has to know what a convolution is.
+     *
+     * The path to that library is NOT set here. Pass it on the command
+     * line:
+     *
+     *   -global cva5.accel.model=/path/to/libcva5_accel_model.so
+     *
+     * Without it the registers answer and every inference returns zero,
+     * with one line in the log saying so -- which is better than a machine
+     * that refuses to start because an optional accelerator is absent.
+     *
+     * PLIC source 3, matching examples/sw/soc.h's PLIC_SRC_ACCEL.
+     */
+    {
+        DeviceState *accel = qdev_new("cva5.accel");
+
+        qdev_prop_set_uint32(accel, "ram-base", CVA5_RAM_BASE);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(accel), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(accel), 0, CVA5_ACCEL_BASE);
+        sysbus_connect_irq(SYS_BUS_DEVICE(accel), 0,
+                           qdev_get_gpio_in(DEVICE(plic), 3));
+    }
+
+    /* Boot ROM: the reset vector, and the two instructions it holds */
+    {
+        MemoryRegion *rom = g_new(MemoryRegion, 1);
+        static const uint32_t boot[2] = {
+            (CVA5_ROM_HI << 12) | (1u << 7) | 0x37u,    /* lui  x1, %hi    */
+            (CVA5_ROM_LO << 20) | (1u << 15) | 0x67u,   /* jalr x0, %lo(x1) */
+        };
+
+        memory_region_init_rom(rom, NULL, "cva5.rom", CVA5_ROM_SIZE,
+                               &error_fatal);
+        memory_region_add_subregion(sysmem, CVA5_ROM_BASE, rom);
+        rom_add_blob_fixed_as("cva5.rom", boot, sizeof(boot), CVA5_ROM_BASE,
+                              &address_space_memory);
+    }
+
+    /*
+     * The application. The reset vector is the boot ROM above, which jumps
+     * here, so a kernel whose entry point is not CVA5_APP_ENTRY would be
+     * loaded and then never reached -- hence the check.
+     */
+    if (machine->kernel_filename) {
+        if (load_elf(machine->kernel_filename, NULL, NULL, NULL, &entry, NULL,
+                     NULL, NULL, 0, EM_RISCV, 1, 0) <= 0) {
+            error_report("could not load kernel '%s'",
+                         machine->kernel_filename);
+            exit(1);
+        }
+        if (entry != CVA5_APP_ENTRY) {
+            warn_report("kernel entry is 0x%" PRIx64 ", but the reset vector "
+                        "is 0x%x", entry, CVA5_APP_ENTRY);
+        }
+    }
+}
+
+static void cva5_pynq_machine_init(MachineClass *mc)
+{
+    mc->desc = "CVA5 on the PYNQ-Z2 (RV32IM, machine mode)";
+    mc->init = cva5_pynq_init;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->default_cpus = 1;
+    mc->default_cpu_type = TYPE_RISCV_CPU_BASE32;
+}
+
+CVA5_DEFINE_MACHINE("cva5-pynq", cva5_pynq_machine_init)
diff --git a/hw/riscv/cva5_accel.c b/hw/riscv/cva5_accel.c
new file mode 100644
index 0000000..e55d73a
--- /dev/null
+++ b/hw/riscv/cva5_accel.c
@@ -0,0 +1,411 @@
+/*
+ * cva5_accel -- the hls4ml accelerator's control block and DMA, for QEMU.
+ *
+ * This models the plumbing in examples/xilinx/axi/cva5_accel_axi.sv and
+ * nothing else. The network itself is loaded: tools/nn_accel/host_model.py
+ * builds hls4ml's own generated C++ into libcva5_accel_model.so, which this
+ * dlopens. That is deliberate -- a model written here would be stale the
+ * first time the network was retrained, and the generated code is the same
+ * C++ Vitis HLS turns into the RTL, verified against the board on all eight
+ * CIFAR images including the packed result word.
+ *
+ * What is modelled, and all of it exists because it has caused a bug on
+ * hardware at least once:
+ *
+ *   The DMA takes an OFFSET within main memory, not an address. Its port is
+ *   only as wide as the window, so a pointer would put the top bits nowhere
+ *   and read from offset zero -- the reset vector, streamed into the
+ *   accelerator, returning a confident wrong answer.
+ *
+ *   DMA_CONTROL starts only on bit 31. aximm2s reads the top byte's strobe,
+ *   so a plain write clears the flags and starts nothing, which looks
+ *   exactly like a DMA that was never connected.
+ *
+ *   The pad counter. Four bytes a pixel, R G B and a zero; cva5_axis_lane
+ *   drops the top byte and counts the ones that were not zero. Nothing
+ *   downstream can tell a mis-packed image from a correct one -- the colours
+ *   shift and the classifier quietly worsens -- so the count is the only
+ *   symptom there is.
+ *
+ *   result_valid is set by a beat arriving and cleared by the result being
+ *   read, in that priority. It resets only with the device, not when a guest
+ *   program is reloaded, so a result nobody collected is still here for the
+ *   next program -- which on hardware produced eight identical
+ *   classifications in 31 cycles each.
+ *
+ *   irq IS result_valid, so reading the result lowers the line. Completing
+ *   the PLIC source before that read leaves it high and the source comes
+ *   straight back.
+ *
+ * What is NOT modelled: timing. A real inference is 7,093 cycles and this
+ * one is instant. Nothing in the software depends on the latency -- it polls
+ * a status bit or waits on an interrupt -- but a program that measured it
+ * would get nonsense, and examples/sw/cifar.c's cycle column is meaningless
+ * under QEMU for that reason.
+ *
+ * Lives in hw/riscv/ beside the machine it belongs to, which is also
+ * where its meson.build line goes.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/* This tree's QEMU has the reorganised headers -- hw/core/sysbus.h rather
+ * than hw/sysbus.h, system/address-spaces.h rather than exec/. The ones
+ * confirmed by hw/riscv/cva5_pynq.c are included directly; the rest are
+ * probed, so this file builds against either layout. */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/core/sysbus.h"
+#include "system/address-spaces.h"
+
+#if defined(__has_include)
+#  if __has_include("hw/core/irq.h")
+#    include "hw/core/irq.h"
+#  else
+#    include "hw/irq.h"
+#  endif
+#  if __has_include("hw/core/qdev-properties.h")
+#    include "hw/core/qdev-properties.h"
+#  else
+#    include "hw/qdev-properties.h"
+#  endif
+#else
+#  include "hw/irq.h"
+#  include "hw/qdev-properties.h"
+#endif
+
+#include "migration/vmstate.h"
+
+#include <dlfcn.h>
+
+#define TYPE_CVA5_ACCEL "cva5.accel"
+OBJECT_DECLARE_SIMPLE_TYPE(Cva5AccelState, CVA5_ACCEL)
+
+/* examples/sw/soc.h is the authority for every one of these. */
+#define R_DMA_CONTROL   0x00
+#define R_DMA_ADDRLO    0x08
+#define R_DMA_ADDRHI    0x0c
+#define R_DMA_LENLO     0x18
+#define R_DMA_LENHI     0x1c
+#define R_ACCEL_CTRL    0x20
+#define R_ACCEL_STATUS  0x24
+#define R_ACCEL_RESULT  0x28
+#define R_ACCEL_PADSEEN 0x2c
+
+#define DMA_START       (1u << 31)
+#define DMA_BUSY        (1u << 31)
+#define DMA_COMPLETE    (1u << 29)
+
+#define ST_DONE         (1u << 0)
+#define ST_IDLE         (1u << 1)
+#define ST_READY        (1u << 2)
+#define ST_RESULT       (1u << 3)
+#define ST_DMA_DONE     (1u << 4)
+
+#define IMG_PIXELS      (32 * 32)
+#define IMG_BYTES       (IMG_PIXELS * 4)
+
+typedef uint32_t (*cva5_infer_fn)(const unsigned char *);
+
+struct Cva5AccelState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /* Where main memory starts, so an offset can be turned back into an
+     * address. The guest writes offsets because the hardware's port is
+     * narrower than the bus. */
+    uint32_t ram_base;
+    char *model_path;
+
+    uint32_t dma_addr;
+    uint32_t dma_len;
+    uint32_t dma_ctrl;
+    uint32_t result;
+    uint32_t pad_seen;
+    bool result_valid;
+    bool ap_start;
+
+    void *dl;
+    cva5_infer_fn infer;
+};
+
+static void cva5_accel_update_irq(Cva5AccelState *s)
+{
+    /* irq is result_valid in the RTL, not a separate latch. */
+    qemu_set_irq(s->irq, s->result_valid);
+}
+
+/*
+ * One inference: read the image out of guest memory, drop the pad byte of
+ * each pixel and count the ones that were not zero, hand the rest to the
+ * model.
+ */
+static void cva5_accel_run(Cva5AccelState *s)
+{
+    g_autofree uint8_t *buf = NULL;
+    uint32_t len = s->dma_len;
+    hwaddr addr = (hwaddr)s->ram_base + s->dma_addr;
+    uint32_t i;
+
+    if (len != IMG_BYTES) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "cva5.accel: DMA length %u, the accelerator consumes "
+                      "exactly %u bytes (32x32 pixels, 4 bytes each)\n",
+                      len, (unsigned)IMG_BYTES);
+        if (len > IMG_BYTES) {
+            len = IMG_BYTES;
+        } else {
+            s->dma_ctrl = (s->dma_ctrl & ~DMA_BUSY) | DMA_COMPLETE;
+            return;
+        }
+    }
+
+    buf = g_malloc0(IMG_BYTES);
+    if (address_space_read(&address_space_memory, addr,
+                           MEMTXATTRS_UNSPECIFIED, buf, len) != MEMTX_OK) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "cva5.accel: DMA read from 0x%" HWADDR_PRIx " failed -- "
+                      "note that DMA_ADDRLO takes an OFFSET within main "
+                      "memory, not a pointer\n", addr);
+        s->dma_ctrl = (s->dma_ctrl & ~DMA_BUSY) | DMA_COMPLETE;
+        return;
+    }
+
+    /* cva5_axis_lane: tdata[23:0] through, the top byte counted if set.
+     * Saturating, because a counter that wraps to zero reports success. */
+    for (i = 0; i < IMG_PIXELS; i++) {
+        if (buf[i * 4 + 3] != 0 && s->pad_seen != 0xffff) {
+            s->pad_seen++;
+        }
+    }
+
+    if (!s->infer) {
+        qemu_log_mask(LOG_UNIMP,
+                      "cva5.accel: no model loaded, returning zero -- build "
+                      "one with 'make -C tools/nn_accel host-model'\n");
+        s->result = 0;
+    } else {
+        s->result = s->infer(buf);
+    }
+
+    s->result_valid = true;
+    s->dma_ctrl = (s->dma_ctrl & ~DMA_BUSY) | DMA_COMPLETE;
+    cva5_accel_update_irq(s);
+}
+
+static uint64_t cva5_accel_read(void *opaque, hwaddr off, unsigned size)
+{
+    Cva5AccelState *s = CVA5_ACCEL(opaque);
+    uint32_t v;
+
+    switch (off) {
+    case R_DMA_CONTROL:
+        return s->dma_ctrl;
+    case R_DMA_ADDRLO:
+        return s->dma_addr;
+    case R_DMA_ADDRHI:
+    case R_DMA_LENHI:
+        return 0;
+    case R_DMA_LENLO:
+        return s->dma_len;
+    case R_ACCEL_CTRL:
+        return s->ap_start ? 1 : 0;
+    case R_ACCEL_STATUS:
+        /* Idle and ready always: the model returns within the write that
+         * started it, so the guest can never observe it running. */
+        v = ST_IDLE | ST_READY;
+        if (s->result_valid) {
+            v |= ST_RESULT | ST_DONE;
+        }
+        if (s->dma_ctrl & DMA_COMPLETE) {
+            v |= ST_DMA_DONE;
+        }
+        return v;
+    case R_ACCEL_RESULT:
+        /* The read is the acknowledgement. This is what lowers irq, and
+         * software that completes its PLIC source before getting here will
+         * see the source raised again immediately. */
+        v = s->result;
+        s->result_valid = false;
+        cva5_accel_update_irq(s);
+        return v;
+    case R_ACCEL_PADSEEN:
+        return s->pad_seen;
+    default:
+        qemu_log_mask(LOG_UNIMP, "cva5.accel: read of unmapped +0x%" HWADDR_PRIx
+                      "\n", off);
+        return 0;
+    }
+}
+
+static void cva5_accel_write(void *opaque, hwaddr off, uint64_t val,
+                             unsigned size)
+{
+    Cva5AccelState *s = CVA5_ACCEL(opaque);
+
+    switch (off) {
+    case R_DMA_CONTROL:
+        /* Only bit 31 starts it. aximm2s decodes the top byte's strobe, so
+         * a plain write of 1 -- or of 0 -- clears the flags and starts
+         * nothing. Getting this wrong on hardware looked exactly like a DMA
+         * that was never connected, so it is modelled rather than
+         * simplified. */
+        if (val & DMA_START) {
+            s->dma_ctrl = DMA_BUSY;
+            cva5_accel_run(s);
+        } else {
+            s->dma_ctrl = 0;
+        }
+        return;
+    case R_DMA_ADDRLO:
+        s->dma_addr = val;
+        return;
+    case R_DMA_LENLO:
+        s->dma_len = val;
+        return;
+    case R_DMA_ADDRHI:
+    case R_DMA_LENHI:
+        return;
+    case R_ACCEL_CTRL:
+        /* ap_start is taken on ap_ready, which here is the same cycle. */
+        s->ap_start = false;
+        return;
+    case R_ACCEL_RESULT:
+    case R_ACCEL_STATUS:
+    case R_ACCEL_PADSEEN:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "cva5.accel: write to read-only +0x%" HWADDR_PRIx "\n",
+                      off);
+        return;
+    default:
+        qemu_log_mask(LOG_UNIMP, "cva5.accel: write to unmapped +0x%"
+                      HWADDR_PRIx "\n", off);
+        return;
+    }
+}
+
+static const MemoryRegionOps cva5_accel_ops = {
+    .read = cva5_accel_read,
+    .write = cva5_accel_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void cva5_accel_reset(DeviceState *dev)
+{
+    Cva5AccelState *s = CVA5_ACCEL(dev);
+
+    s->dma_addr = 0;
+    s->dma_len = 0;
+    s->dma_ctrl = 0;
+    s->result = 0;
+    s->pad_seen = 0;
+    s->result_valid = false;
+    s->ap_start = false;
+    cva5_accel_update_irq(s);
+}
+
+static void cva5_accel_realize(DeviceState *dev, Error **errp)
+{
+    Cva5AccelState *s = CVA5_ACCEL(dev);
+
+    if (!s->model_path || !*s->model_path) {
+        /*
+         * Not an error -- the machine is useful without the accelerator,
+         * and refusing to start would be worse. But warn_report rather
+         * than qemu_log_mask: LOG_UNIMP is off unless asked for, and the
+         * first time this happened the guest classified four of eight
+         * images correctly by chance and said PASS on the agreement it
+         * had with itself. A model that is not there has to say so where
+         * someone will see it.
+         */
+        warn_report("cva5.accel: no model given, every inference returns "
+                    "zero. Pass "
+                    "-global driver=cva5.accel,property=model,value=<.so>");
+        return;
+    }
+
+    s->dl = dlopen(s->model_path, RTLD_NOW | RTLD_LOCAL);
+    if (!s->dl) {
+        error_setg(errp, "cva5.accel: cannot load %s: %s",
+                   s->model_path, dlerror());
+        return;
+    }
+    s->infer = (cva5_infer_fn)dlsym(s->dl, "cva5_accel_infer");
+    if (!s->infer) {
+        error_setg(errp, "cva5.accel: %s has no cva5_accel_infer",
+                   s->model_path);
+        dlclose(s->dl);
+        s->dl = NULL;
+        return;
+    }
+}
+
+static void cva5_accel_init(Object *obj)
+{
+    Cva5AccelState *s = CVA5_ACCEL(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &cva5_accel_ops, s,
+                          TYPE_CVA5_ACCEL, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+/* No DEFINE_PROP_END_OF_LIST: it was removed when device_class_set_props
+ * started taking the count from ARRAY_SIZE, which also made the array
+ * const. */
+static const Property cva5_accel_props[] = {
+    DEFINE_PROP_UINT32("ram-base", Cva5AccelState, ram_base, 0x80000000),
+    DEFINE_PROP_STRING("model", Cva5AccelState, model_path),
+};
+
+static const VMStateDescription vmstate_cva5_accel = {
+    .name = TYPE_CVA5_ACCEL,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32(dma_addr, Cva5AccelState),
+        VMSTATE_UINT32(dma_len, Cva5AccelState),
+        VMSTATE_UINT32(dma_ctrl, Cva5AccelState),
+        VMSTATE_UINT32(result, Cva5AccelState),
+        VMSTATE_UINT32(pad_seen, Cva5AccelState),
+        VMSTATE_BOOL(result_valid, Cva5AccelState),
+        VMSTATE_BOOL(ap_start, Cva5AccelState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void cva5_accel_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = cva5_accel_realize;
+    /* dc->reset went away with the Resettable conversion; this is the
+     * shim for devices that have not been converted. */
+    device_class_set_legacy_reset(dc, cva5_accel_reset);
+    dc->vmsd = &vmstate_cva5_accel;
+    device_class_set_props(dc, cva5_accel_props);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo cva5_accel_info = {
+    .name = TYPE_CVA5_ACCEL,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Cva5AccelState),
+    .instance_init = cva5_accel_init,
+    .class_init = cva5_accel_class_init,
+};
+
+static void cva5_accel_register_types(void)
+{
+    type_register_static(&cva5_accel_info);
+}
+
+type_init(cva5_accel_register_types)
