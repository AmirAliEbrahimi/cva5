test_benches/verilator/build
vivado/
qemu-build/
build/

# examples/sw build outputs. 'make clean' removes these, but a run leaves them
# behind and 'git add -A' will otherwise stage them -- trace.fst alone is 369 MB
# for a short program.
examples/sw/*.elf
examples/sw/*.elf.rawbinary
examples/sw/*.elf.dissasembled
examples/sw/*.hex
examples/sw/*.sim
examples/sw/*.tcl
examples/sw/*.mif
examples/sw/*_log.txt
examples/sw/signature.txt
examples/sw/*.fst
examples/sw/*.fst.hier
__pycache__/
*.pyc

# Generated from the trained model by tools/nn_accel/export_{weights,images}.py.
# 32 KB of .rodata derived from a .pt that is not in this tree either.
examples/sw/images.h
examples/sw/weights.h
